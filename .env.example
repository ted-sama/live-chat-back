# Public base URL served by the Cloudflare tunnel. Media URLs are built from it.
SERVER_URL=https://api.intrlude.app

# Shared secret required on every /api/upload route (header: x-api-key).
# Generate one with: openssl rand -hex 32
API_KEY=

# Comma-separated list of allowed browser origins, or * to allow any.
# Narrow this to the front-end origin once it is deployed.
CORS_ORIGINS=*

PORT=3000

# Cloudflare tunnel connector token (Zero Trust > Networks > Tunnels).
TUNNEL_TOKEN=

# Uploads: per-file cap in bytes. Cloudflare's free plan rejects bodies over 100MB.
UPLOAD_MAX_BYTES=94371840

# Maintenance: files older than the TTL are deleted, and the oldest files are
# evicted whenever the folder grows past the total cap.
UPLOAD_TTL_MINUTES=120
UPLOAD_MAX_TOTAL_BYTES=5368709120
CLEANUP_INTERVAL_MINUTES=10

# Hard cap on a single YouTube download.
YTDL_MAX_BYTES=524288000

# Optional cookie header used by ytdl-core against YouTube.
YOUTUBE_COOKIES=
